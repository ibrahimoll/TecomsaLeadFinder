# =====================================================================
# TECOMSA LeadFinder AI - environment template
# Copy to `.env` and fill in values. NEVER commit a real `.env` file.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

# ---- Application -----------------------------------------------------
# development | test | staging | production
ENVIRONMENT=development

# Required in staging/production (min. 32 chars). In development an insecure
# fallback is used when empty so the app can start.
APP_SECRET=
JWT_SECRET=

# Public URL of the frontend (used for CORS)
FRONTEND_URL=http://localhost:3000

# Session lifetime in minutes (default: 8 hours)
SESSION_EXPIRE_MINUTES=480

# Send the session cookie only over HTTPS. Must be true in production.
COOKIE_SECURE=false

# ---- PostgreSQL ------------------------------------------------------
# Use URL-safe characters in the password (letters, digits, - _ .)
POSTGRES_USER=leadfinder
POSTGRES_PASSWORD=change-me-local-dev-password
POSTGRES_DB=leadfinder

# Used when running the backend OUTSIDE Docker. Inside Docker Compose the
# backend's DATABASE_URL is built from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://leadfinder:change-me-local-dev-password@localhost:5432/leadfinder

# Separate database used only by the automated tests (name must end in _test)
TEST_DATABASE_URL=postgresql+psycopg://leadfinder:change-me-local-dev-password@localhost:5432/leadfinder_test

# ---- Odoo imports (CSV / XLSX) ---------------------------------------
# Allow Sales Managers (not only Admins) to run Odoo imports.
MANAGERS_CAN_IMPORT=false
# Where uploaded source files are kept (relative to backend/). PostgreSQL is the datastore.
IMPORT_STORAGE_DIR=storage/imports
# Upload limits
IMPORT_MAX_BYTES=20971520
IMPORT_MAX_ROWS=50000

# ---- Frontend --------------------------------------------------------
# Where the Next.js server proxies /api/* requests (server-side only)
BACKEND_INTERNAL_URL=http://localhost:8000

# ---- Backups (docker-compose.prod.yml) -------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ---- Reserved for future phases (NOT used in Phase 0) ----------------
# The application runs without any of these values.
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=

LUSHA_API_KEY=

AI_API_KEY=
